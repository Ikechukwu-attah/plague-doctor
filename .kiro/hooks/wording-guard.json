{
  "version": "v1",
  "hooks": [
    {
      "name": "EVD-9(b): Wording guard on copy/TSX save",
      "trigger": "PostFileSave",
      "matcher": "(src/evidence/copy/.*|src/.*\\.tsx)$",
      "action": { "type": "command", "command": "npx vitest run tests/evidence/wording-guard.test.ts" }
    }
  ]
}
