{
  "version": "v1",
  "hooks": [
    {
      "name": "EVD-9(c): Ingestion tests on ingest/fixture change",
      "trigger": "PostFileSave",
      "matcher": "(src/server/ingest/.*|fixtures/.*)$",
      "action": { "type": "command", "command": "npx vitest run tests/ingest tests/properties" }
    }
  ]
}
